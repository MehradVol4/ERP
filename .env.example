# Copy to `.env` and fill in real values before running `docker compose up`.
# Generate each secret with:  node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"

# ---- Postgres ----
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=change-me

# ---- Strapi secrets ----
# APP_KEYS is a comma-separated list of at least two keys.
APP_KEYS=change-me-1,change-me-2
API_TOKEN_SALT=change-me
ADMIN_JWT_SECRET=change-me
TRANSFER_TOKEN_SALT=change-me
JWT_SECRET=change-me
ENCRYPTION_KEY=change-me

# ---- Frontend ----
# URL the browser uses to reach Strapi (baked into the client bundle at build).
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
NEXTAUTH_SECRET=change-me
NEXTAUTH_URL=http://localhost:3000
